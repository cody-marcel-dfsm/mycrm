{
  "name": "my-crm",
  "version": "0.2.37",
  "description": "Provider-neutral CRM expertise; ad hoc dynamic workflows require live BOS contracts",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "files": [
    "examples/",
    "plugins/",
    "src/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:contracts": "node scripts/validate-contracts.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:release": "node scripts/check-release.mjs",
    "install:local": "node scripts/codex-local-install.mjs install",
    "install:verify": "node scripts/codex-local-install.mjs verify",
    "hooks:install": "node scripts/install-hooks.mjs",
    "oracle:review": "node scripts/oracle-review.mjs review",
    "oracle:proposal": "node scripts/oracle-review.mjs proposal",
    "oracle:verify": "node scripts/oracle-review.mjs verify-index",
    "oracle:verify-commit": "node scripts/oracle-review.mjs verify-commit HEAD",
    "release:check": "npm run build && npm test && npm run check:release",
    "test": "npm run check:privacy && npm run check:boundary && npm run check:contracts && node --test tests/*.test.mjs",
    "vault:init": "node scripts/init-vault.mjs",
    "vault:sync": "node scripts/vault.mjs sync",
    "vault:query": "node scripts/vault.mjs query",
    "acceptance:marketplace": "node scripts/run-marketplace-prompts.mjs",
    "submission:cases": "node scripts/run-marketplace-prompts.mjs --submission-cases"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
