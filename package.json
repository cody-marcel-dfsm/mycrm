{
  "name": "my-crm",
  "version": "0.2.10",
  "description": "Independent native GPT plugin and reference implementation for building provider-neutral CRM automations on BOS",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "files": [
    "contracts/",
    "examples/",
    "plugins/",
    "src/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:contracts": "node scripts/validate-contracts.mjs",
    "check:release": "node scripts/check-release.mjs",
    "contracts:import": "node scripts/import-bos-contract.mjs",
    "contracts:import-boc": "node scripts/import-boc-dependency-contract.mjs",
    "install:local": "node scripts/codex-local-install.mjs install",
    "install:verify": "node scripts/codex-local-install.mjs verify",
    "release:check": "npm run build && npm test && npm run check:release",
    "test": "npm run check:boundary && npm run check:contracts && node --test tests/*.test.mjs",
    "test:live": "node scripts/verify-live-contract.mjs",
    "vault:init": "node scripts/init-vault.mjs",
    "vault:sync": "node scripts/vault.mjs sync",
    "vault:query": "node scripts/vault.mjs query"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
