{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfsm.ai/contracts/bos/journey-client-action-required/v1",
  "title": "BOS Journey Client Action Required",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "status", "current_step", "error", "resolution"],
  "properties": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 160},
    "status": {"const": "client_action_required"},
    "current_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "type", "operation"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "type": {"const": "server"},
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "correlation_id", "details"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "correlation_id": {"type": "string", "minLength": 1},
        "details": {"type": "array", "items": {"type": "object"}}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "instruction",
        "requires_user_approval",
        "approval_scope",
        "after_success"
      ],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
        },
        "requires_user_approval": {"type": "boolean"},
        "approval_scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "after_success": {"$ref": "#/$defs/stepAction"}
      }
    }
  },
  "$defs": {
    "stepAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "method", "href", "payload_schema"],
      "properties": {
        "verb": {"const": "step"},
        "method": {"const": "POST"},
        "href": {
          "type": "string",
          "pattern": "^/bos/apps/lead-director/api/v1/organizations/[^/]+/journeys/[^/]+/step\\?capability=.+$"
        },
        "payload_schema": {"type": "null"}
      }
    }
  }
}
