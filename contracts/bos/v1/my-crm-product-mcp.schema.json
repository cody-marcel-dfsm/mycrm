{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfsm.ai/contracts/bos/v1/my-crm-product-mcp.schema.json",
  "title": "My CRM product MCP discovery contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resource", "context", "contract", "operations"],
  "properties": {
    "schemaVersion": { "const": "bos.product-mcp/v1" },
    "resource": { "const": "https://dfsm.ai/mcp/apps/leaddirector/crm" },
    "context": {
      "type": "object",
      "required": ["contextId", "organizationLabel", "roleLabel"],
      "properties": {
        "contextId": { "type": "string", "minLength": 1 },
        "organizationLabel": { "type": "string", "minLength": 1 },
        "roleLabel": { "type": "string", "minLength": 1 }
      }
    },
    "contract": {
      "type": "object",
      "required": ["digest", "discoveryEpoch", "observedAt"],
      "properties": {
        "digest": { "type": "string", "minLength": 8 },
        "discoveryEpoch": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "semanticOperation", "sideEffect", "inputSchema"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "semanticOperation": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$" },
          "sideEffect": { "enum": ["read", "create", "write", "delete"] },
          "idempotent": { "type": "boolean" },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["handle", "displayName"],
        "properties": {
          "handle": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
