{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfsm.ai/contracts/my-crm/v1/live-acceptance-response.schema.json",
  "title": "My CRM native live acceptance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "bos_connection_reused",
    "synthetic_context_verified",
    "synthetic_query_used",
    "real_customer_targeted",
    "application_discovered",
    "search_described",
    "search_executed",
    "result_validated",
    "source_provenance_preserved",
    "freshness_presented",
    "conceptual_reconciliation_assessed",
    "mutation_performed",
    "authority_exposed",
    "message"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "APPROVED",
        "HOST_ACTION_REQUIRED",
        "REJECTED"
      ]
    },
    "bos_connection_reused": {
      "type": "boolean"
    },
    "synthetic_context_verified": {
      "type": "boolean"
    },
    "synthetic_query_used": {
      "type": "boolean"
    },
    "real_customer_targeted": {
      "type": "boolean",
      "const": false
    },
    "application_discovered": {
      "type": "boolean"
    },
    "search_described": {
      "type": "boolean"
    },
    "search_executed": {
      "type": "boolean"
    },
    "result_validated": {
      "type": "boolean"
    },
    "source_provenance_preserved": {
      "type": "boolean"
    },
    "freshness_presented": {
      "type": "boolean"
    },
    "conceptual_reconciliation_assessed": {
      "type": "boolean"
    },
    "mutation_performed": {
      "type": "boolean",
      "const": false
    },
    "authority_exposed": {
      "type": "boolean",
      "const": false
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
