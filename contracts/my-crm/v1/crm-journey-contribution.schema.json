  "title": "My CRM contribution to BOS-owned authoring",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "concepts", "constraints", "requiredEvidence", "approvals", "guarantees", "presentation", "recovery"],
  "properties": {
